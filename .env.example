# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# ---------------------------------------------------------------------------
# Postgres connection pool (all OPTIONAL). Defaults are derived from the host,
# so the app runs well on any machine without setting these. Override only when
# you need to tune for a specific environment.
# ---------------------------------------------------------------------------

# Max clients in the pool. Default: clamp(cpuCores * 2, 4, 20).
# PG_POOL_MAX=10

# Min idle clients kept warm. Default: 0.
# PG_POOL_MIN=0

# Close an idle client after this many ms. Default: 30000.
# PG_IDLE_TIMEOUT_MS=30000

# Give up acquiring a connection after this many ms. Default: 10000.
# PG_CONNECT_TIMEOUT_MS=10000

# Server-side statement timeout (ms). Default: 30000.
# PG_STATEMENT_TIMEOUT_MS=30000

# Client-side query timeout (ms). Default: 30000.
# PG_QUERY_TIMEOUT_MS=30000

# Recycle a client after this many uses (guards against leaks/imbalance). Default: 7500.
# PG_MAX_USES=7500

# application_name shown in pg_stat_activity. Default: "node-backend".
# PG_APP_NAME=node-backend

# SSL mode: true | false | require | no-verify. Default: inferred from sslmode in DATABASE_URL.
# PG_SSL=false

# Allow the process to exit while the pool is idle. Default: false.
# PG_ALLOW_EXIT_ON_IDLE=false

# ---------------------------------------------------------------------------
# Redis (OTP store + rate limiter). The URL is all you usually need locally.
# Run a server first:  brew services start redis   (or a docker redis container)
# ---------------------------------------------------------------------------

# Full connection string. Preferred. Format: redis[s]://[user:pass@]host:port[/db]
REDIS_URL="redis://localhost:6379"

# --- OR, instead of REDIS_URL, set these individually (all OPTIONAL) ---
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_USERNAME=
# REDIS_DB=0

# Prefix applied to every key (e.g. "app:"). Default: none.
# REDIS_KEY_PREFIX=

# Socket connect timeout (ms). Default: 10000.
# REDIS_CONNECT_TIMEOUT_MS=10000

# Reconnect attempts before giving up (0 = retry forever). Default: 20.
# REDIS_MAX_RETRIES=20

# Reconnect backoff base / ceiling (ms). Default: 100 / 3000.
# REDIS_RETRY_BASE_MS=100
# REDIS_RETRY_MAX_MS=3000

# Keepalive ping interval while idle (ms; 0 = off). Default: 30000.
# REDIS_PING_INTERVAL_MS=30000

# Set to false to disable Redis entirely (OTP/rate-limit features will no-op/fail). Default: true.
# REDIS_ENABLED=true
